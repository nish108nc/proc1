<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5" style="width: 650px;">
        <div class="card shadow rounded-4 border-4">
            <div class="card-body">
                <div class="text-center text-primary">
                    <h2>Update Student Data</h2>

                </div>
                <form action="/update-student/<%= student._id %>" method="POST">
                    <div class="mb-3">
                        <input type="text" value="<%= student.fname %>" name="fname" placeholder="Enter first name" class="form-control border-primary">

                    </div>
                    <div class="mb-3">
                        <input type="text" value="<%= student.lname %>" name="lname" placeholder="Enter Last name" class="form-control border-primary">

                    </div>
                    <div class="mb-3">
                        <input type="email" value="<%= student.email %>" name="email" placeholder="Enter Email Id" class="form-control border-primary">

                    </div>
                    <div class="mb-3">
                        <input type="tel" value="<%= student.phone %>" name="phone" placeholder="Enter phone number" class="form-control border-primary">

                    </div>
                    <div class="mb-3">
                        <label for="address">Address</label>
                        <textarea name="address" id="address" class="form-control border-primary">
                         <%= student.address %>
                        </textarea>
                    </div>
                    <div>
                        <button class="btn btn-primary">Update</button>
                        <a class="btn btn-danger" href="/">Cancel</a>
                    </div>
                </form>

            </div>

        </div>

    </div>
</body>
</html>