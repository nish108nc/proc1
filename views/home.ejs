<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crud Apps</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="container mt-5">
        <div class="card shadow rounded-4 border-4">
            <div class="card-body">
                <div class="text-center text-primary">
                    <h2>List of Students</h2>

                </div>
                <div class="d-flex justify-content-end mb-2">
                    <a class="btn btn-primary" href="/add-student">
                        <i class="bi bi-person-add"></i> Add New Student</a>
                </div>
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Sr. No.</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% var sno=1 %>
                        <% students.forEach(student=>{ %>

                        
                        <tr>
                            <td><%= sno++ %></td>
                            <td><%= student.fname %></td>
                            <td><%= student.lname %></td>
                            <td><%= student.email %></td>
                            <td><%= student.phone %></td>
                            <td>
                                <a class="text-info" href="/show-student/<%= student._id %>" title="Show">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a class="text-primary" href="/update-student/<%= student._id %>" title="Edit">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a class="text-danger" href="/delete-student/<%= student._id %>" title="Delete">
                                    <i class="bi bi-trash-fill"></i>
                                </a>

                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>

            </div>

        </div>

    </div>
</body>
</html>